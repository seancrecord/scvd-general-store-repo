{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "rules": [{"type":"Text","globs":["**/screening/operator/client.txt"],"fallthrough":true}],
  "name": "scvd-screening-qualification",
  "main": "index.ts",
  // Latest date supported by the installed qualification runtime; no dependency upgrade.
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {"enabled":true},
  "durable_objects": {"bindings":[{"name":"SCREENING_BUDGET","class_name":"ScreeningBudget"}]},
  "migrations": [{"tag":"qualification-v1","new_sqlite_classes":["ScreeningBudget"]}],
  // Empty = disabled. Authenticated provider URLs belong in secrets when provisioned.
  "vars": {"SCREENING_BUDGET_POLICY":"","SCREENING_READER_POLICY":"","SCREENING_PROVIDERS":""}
}
