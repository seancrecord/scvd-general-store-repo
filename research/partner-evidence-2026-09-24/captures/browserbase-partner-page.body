.23 1.38-45.84 1.39-21.62 5.16-46.77H158.92q-7.38 23.23-10.46 44.92-3.07 21.69-3.07 47.69 0 26.39 3.07 49 3.08 22.62 10.46 46.24Zm212.16 0h218.46q4.38-30.23 5.77-51.47 1.38-21.23 1.38-43.77 0-21.53-1.38-41.96-1.39-20.42-5.77-50.65H371.08q-4.39 30.23-5.77 50.65-1.39 20.43-1.39 41.96 0 22.54 1.39 43.77 1.38 21.24 5.77 51.47Zm263.84 0h166.16q7.38-23.62 10.46-46.24 3.07-22.61 3.07-49 0-26-3.07-47.69-3.08-21.69-10.46-44.92H635.92q3.39 33.08 4.77 53.88 1.39 20.81 1.39 38.73 0 22.39-1.7 44-1.69 21.62-5.46 51.24Zm-7.69-233.23h159.23q-35.31-76.7-97.81-125.2t-145.19-64.04q28.08 37.77 49.04 84.81t34.73 104.43Zm-247.46 0h202.08q-13.31-56.47-39.5-106.54-26.2-50.08-62.35-89.23-33.92 31.23-57.27 77.15t-42.96 118.62Zm-206.23 0h159.85q12.53-55.54 33-102.08 20.46-46.54 49.15-86.54-82.69 15.92-144.08 63.61-61.38 47.7-97.92 125.01Z"></path></svg></span></a></li><li><a class="nav__subnav__link btn btn--nav-primary btn--icon-left btn--menu-item btn--menu-item--library" href="/templates"><div class="stack"><span class="btn__text">Templates</span></div><span class="btn__icon" aria-hidden="true"><svg aria-hidden="true" class="material-symbols-outlined" fill="currentColor" focusable="false" height="24" viewBox="0 -960 960 960" width="24" xmlns="http://www.w3.org/2000/svg"><path d="M130-830h307.31v307.31H130V-830Zm45.38 44.77v200.31-200.31ZM522.69-830H830v307.31H522.69V-830Zm62.23 44.77v200.31-200.31ZM130-437.31h307.31V-130H130v-307.31Zm45.38 60.62v201.31-201.31Zm478.47-60.62h45.38v130.77H830v45.39H699.23V-130h-45.38v-131.15H522.69v-45.39h131.16v-130.77Zm-85.77-347.31v216.54h216.54v-216.54H568.08Zm-392.7 0v216.54h216.54v-216.54H175.38Zm0 392.7v216.54h216.54v-216.54H175.38Z"></path></svg></span></a></li></ul></li></ul></div></li><li class="nav__item" data-nav-index="3"><a class="nav__item__button btn btn--nav-primary" href="/pricing">Pricing</a></li><li class="nav__item" data-nav-index="4"><a class="nav__item__button btn btn--nav-primary" href="https://docs.browserbase.com">Docs</a></li><li class="nav__item nav__item--login-mobile"><a class="nav__item__button btn btn--nav-primary" href="/sign-in">Log in</a></li></ul></nav><div class="nav__list--secondary cluster"><div class="nav__item--login-desktop"><a class="btn btn--nav-secondary" href="/sign-in">Log in</a></div><div class="nav__item--cta"><a class="btn btn--secondary" href="/sign-up"><span class="btn__text">Sign up</span></a></div><div class="nav__item--cta"><a class="btn btn--chevron" href="/contact"><span class="btn__text">Get a demo</span><span class="btn__icon"><svg aria-hidden="true" class="material-symbols-outlined" fill="currentColor" focusable="false" height="24" viewBox="0 -960 960 960" width="24" xmlns="http://www.w3.org/2000/svg"><path d="M503.91-480l-189-189L384-738.09 642.09-480 384-221.91 314.91-291l189-189Z"></path></svg></span></a></div></div></div></header><main id="main" class="type-body wrapper"><section class="form form--partner section full wrapper" data-layout="expanded"><div class="form__media" aria-hidden="true"><img alt="" fetchPriority="high" loading="eager" width="3567" height="1434" decoding="sync" data-nimg="1" style="color:transparent" sizes="100vw" srcSet="/_next/image?url=%2Fwebsite-assets%2Fstatic%2Fimg%2Fpartner-form-landscape.webp&amp;w=320&amp;q=75&amp;dpl=dpl_8c8g2oAd1ZAWVVKCdk8Zym6hHWHw 320w, /_next/image?url=%2Fwebsite-assets%2Fstatic%2Fimg%2Fpartner-form-landscape.webp&amp;w=384&amp;q=75&amp;dpl=dpl_8c8g2oAd1ZAWVVKCdk8Zym6hHWHw 384w, /_next/image?url=%2Fwebsite-assets%2Fstatic%2Fimg%2Fpartner-form-landscape.webp&amp;w=481&amp;q=75&amp;dpl=dpl_8c8g2oAd1ZAWVVKCdk8Zym6hHWHw 481w, /_next/image?url=%2Fwebsite-assets%2Fstatic%2Fimg%2Fpartner-form-landscape.webp&amp;w=600&amp;q=75&amp;dpl=dpl_8c8g2oAd1ZAWVVKCdk8Zym6hHWHw 600w, /_next/image?url=%2Fwebsite-assets%2Fstatic%2Fimg%2Fpartner-form-landscape.webp&amp;w=640&amp;q=75&amp;dpl=dpl_8c8g2oAd1ZAWVVKCdk8Zym6hHWHw 640w, /_next/image?url=%2Fwebsite-assets%2Fstatic%2Fimg%2Fpartner-form-landscape.webp&amp;w=960&amp;q=75&amp;dpl=dpl_8c8g2oAd1ZAWVVKCdk8Zym6hHWHw 960w, /_next/image?url=%2Fwebsite-assets%2Fstatic%2Fimg%2Fpartner-form-landscape.webp&amp;w=1120&amp;q=75&amp;dpl=dpl_8c8g2oAd1ZAWVVKCdk8Zym6hHWHw 1120w, /_next/image?url=%2Fwebsite-assets%2Fstatic%2Fimg%2Fpartner-form-landscape.webp&amp;w=1280&amp;q=75&amp;dpl=dpl_8c8g2oAd1ZAWVVKCdk8Zym6hHWHw 1280w, /_next/image?url=%2Fwebsite-assets%2Fstatic%2Fimg%2Fpartner-form-landscape.webp&amp;w=1600&amp;q=75&amp;dpl=dpl_8c8g2oAd1ZAWVVKCdk8Zym6hHWHw 1600w" src="/_next/image?url=%2Fwebsite-assets%2Fstatic%2Fimg%2Fpartner-form-landscape.webp&amp;w=1600&amp;q=75&amp;dpl=dpl_8c8g2oAd1ZAWVVKCdk8Zym6hHWHw"/></div><div class="grid"><div class="textLockUp textLockUp--left form__textLockUp"><div class="textLockUp__content"><h1 class="textLockUp__title u-wordbreak type-heading-2"><span>Partner with Browserbase</span></h1><div class="textLockUp__subhead type-subhead-2"><p>Suggest or submit an integration.</p></div></div></div><div class="partnerForm form-section section"><form class="form-body" noValidate="" aria-label="Partner integration request form"><div class="form-grid"><div class="form-field"><label class="form-label" for="partnerForm-firstName">First Name<span class="form-required" aria-label="required">*</span></label><input class="form-input" id="partnerForm-firstName" type="text" required="" autoComplete="given-name" placeholder="John" name="firstName"/></div><div class="form-field"><label class="form-label" for="partnerForm-lastName">Last Name<span class="form-required" aria-label="required">*</span></label><input class="form-input" id="partnerForm-lastName" type="text" required="" autoComplete="family-name" placeholder="Doe" name="lastName"/></div><div class="form-field"><label class="form-label" for="partnerForm-email">Email<span class="form-required" aria-label="required">*</span></label><input class="form-input" id="partnerForm-email" type="email" required="" autoComplete="email" placeholder="john@example.com" name="email"/><p class="form-error" hidden="" role="alert"> </p></div><div class="form-field"><label class="form-label" for="partnerForm-companyWebsite">Company Website<span class="form-required" aria-label="required">*</span></label><input class="form-input" id="partnerForm-companyWebsite" type="url" required="" placeholder="https://example.com" name="companyWebsite"/></div><div class="form-field"><label class="form-label" for="partnerForm-jobTitle">Job Title<span class="form-required" aria-label="required">*</span></label><input class="form-input" id="partnerForm-jobTitle" type="text" required="" autoComplete="organization-title" placeholder="CTO" name="jobTitle"/></div><div class="form-field"><label class="form-label" for="partnerForm-partnershipType">How can we help?<span class="form-required" aria-label="required">*</span></label><select class="form-select" id="partnerForm-partnershipType" name="partnershipType" required=""><option value="" disabled="" selected="">Select an option</option><option value="submit_integration">I have an integration built that I&#x27;d like to submit</option><option value="request_integration">I want to request that you build an integration</option><option value="partner_discussion">I want to partner, let&#x27;s talk!</option></select></div></div><div class="partnerForm__conditional" hidden=""><div class="partnerForm__submitGrid u-mb--space-4"><div class="form-field"><div class="partnerForm__fieldHeader"><label class="form-label" for="partnerForm-introPageDraftLink">Introduction Page Draft Link<span class="form-required" aria-label="required">*</span></label><div class="partnerForm__resourceLinks"><a href="https://docs.google.com/document/d/1UCEU2ZiW8X9W5Q8e9AXFjxMtorqeqbrXyWOaWK1sE3U/edit?usp=sharing" class="partnerForm__resourceLink" target="_blank" rel="noopener noreferrer">Copy Template</a><span class="partnerForm__resourceSeparator">|</span><a href="https://docs.browserbase.com/integrations/stripe/introduction" class="partnerForm__resourceLink" target="_blank" rel="noopener noreferrer">Example</a></div></div><p class="partnerForm__fieldDescription">Copy our template and customize it for your integration. Then share the link to your draft (make sure it’s public).</p><input class="form-input" id="partnerForm-introPageDraftLink" type="url" placeholder="https://docs.google.com/document/d/your-introduction-page" name="introPageDraftLink"/></div><div class="form-field"><div class="partnerForm__fieldHeader"><label class="form-label" for="partnerForm-quickstartGuideDraftLink">Quickstart Guide Draft Link<span class="form-required" aria-label="required">*</span></label><div class="partnerForm__resourceLinks"><a href="https://docs.google.com/document/d/15K-2eLT6T-U2Zxe8WI5He6DqhEbBmtoIrbF9lAXZFJA/edit?usp=sharing" class="partnerForm__resourceLink" target="_blank" rel="noopener noreferrer">Copy Template</a><span class="partnerForm__resourceSeparator">|</span><a href="https://docs.browserbase.com/integrations/stripe/quickstart" class="partnerForm__resourceLink" target="_blank" rel="noopener noreferrer">Example</a></div></div><p class="partnerForm__fieldDescription">Copy our template and fill in the steps for your integration. Then share the link to your draft (make sure it’s public).</p><input class="form-input" id="partnerForm-quickstartGuideDraftLink" type="url" placeholder="https://docs.google.com/document/d/your-quickstart-guide" name="quickstartGuideDraftLink"/></div></div><div class="form-field"><label class="form-label" for="partnerForm-githubLink">GitHub / Code Link<span class="form-required" aria-label="required">*</span></label><input class="form-input" id="partnerForm-githubLink" type="url" placeholder="https://github.com/your-org/your-integration" name="githubLink"/></div></div><div class="partnerForm__conditional" hidden=""><div class="form-field"><label class="form-label" for="partnerForm-integrationRequest">Integration Request<span class="form-required" aria-label="required">*</span></label><textarea class="form-textarea" id="partnerForm-integrationRequest" name="integrationRequest" placeholder="Describe the integration you&#x27;d like us to build..."></textarea></div></div><div class="partnerForm__conditional" hidden=""><div class="form-field"><label class="form-label" for="partnerForm-moreDetails">Tell us more<span class="form-required" aria-label="required">*</span></label><textarea class="form-textarea" id="partnerForm-moreDetails" name="moreDetails" placeholder="Tell us more about your partnership idea..."></textarea></div></div><div class="form-footer"><p class="partnerForm__support">Have any questions?<!-- --> <a href="mailto:support@browserbase.com" class="form-link">Send an email to support</a></p><button class="btn btn--primary" type="submit"><span class="btn__text">Submit request</span><span class="btn__icon" aria-hidden="true"><svg aria-hidden="true" fill="none" height="12" viewBox="0 0 12 12" width="12" xmlns="http://www.w3.org/2000/svg"><path d="M8.66875 6.4125H0V4.9875H8.66875L4.69062 1.00937L5.7 0L11.4 5.7L5.7 11.4L4.69062 10.3906L8.66875 6.4125Z" fill="currentColor"></path></svg></span></button><p class="form-error form-error--server" hidden="" role="alert"></p><p class="form-disclaimer" role="note">By submitting this form you agree to the processing of your personal data as described in our<!-- --> <a class="form-link" href="/terms-of-service">Terms</a> <!-- -->and<!-- --> <a class="form-link" href="/privacy-policy">Privacy Policy</a>.</p></div></form></div></div></section></main><footer class="section site-footer wrapper theme-red"><div class="site-footer__grid grid"><div class="site-footer__left"><a class="site-footer__branding" href="/"><svg aria-hidden="true" class="site-footer__branding__wordmark" fill="none" height="379" viewBox="0 0 296 379" width="296" xmlns="http://www.w3.org/2000/svg"><path d="M0 378.734v-35.731h12.31c5.123 0 9.226 4.086 9.226 9.187v2.043c0 2.345-.868 4.539-2.355 6.128 2.052 1.686 3.387 4.237 3.387 7.144v2.043c0 5.101-4.104