:137","eip155:480","solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp"],"asset":"USDC","price_usdc_options":[1]},"x-payment-info":{"protocol":"x402","protocols":[{"x402":{}}],"pricingMode":"fixed","price":"1","currency":"USD","x402Version":2,"scheme":"exact","asset":"USDC","accepts":[{"scheme":"exact","network":"eip155:8453","amount":"1000000","asset":"0x833589fcd6edb6e08f4c7c32d4f71b54bda02913","payTo":"0xDD350976B8cfFc65938C0464d39A2C78BE079bd0","extra":{"name":"USD Coin","version":"2"}},{"scheme":"exact","network":"eip155:137","amount":"1000000","asset":"0x3c499c542cef5e3811e1192ce70d8cc03d5c3359","payTo":"0xDD350976B8cfFc65938C0464d39A2C78BE079bd0","extra":{"name":"USD Coin","version":"2"}},{"scheme":"exact","network":"eip155:480","amount":"1000000","asset":"0x79a02482a880bce3f13e09da970dc34db4cd24d1","payTo":"0xDD350976B8cfFc65938C0464d39A2C78BE079bd0","extra":{"name":"USDC","version":"2"}},{"scheme":"exact","network":"solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp","amount":"1000000","asset":"EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v","payTo":"DGxcPrAHL9YM3hW7iXuHFJmr87Zr6AMA4jCYHBpuvMgE"}],"price_usdc":[1],"max_timeout_seconds":300,"challenge_header":"PAYMENT-REQUIRED","payment_header":"PAYMENT-SIGNATURE","legacy_payment_header":"X-PAYMENT","settlement":"The store delivers first and settles after: the goods are produced, then the payment is presented at the last moment before the artifact is signed. A delivery that fails takes no money at all.","discovery":"https://scvd.store/.well-known/x402.json","documentation":"https://scvd.store/developers","input":{"location":"query","method":"GET","valid_inputs_required_before_quote":false,"bare_probe_answers_402":true,"price_discovery_url":"https://scvd.store/menu/context_anchor?view=compact","schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","title":"Context Anchor request","description":"Query parameters for GET /api/buy/context_anchor. Sent on the query string; the payment rides in the PAYMENT-SIG