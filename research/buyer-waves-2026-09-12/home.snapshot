  <script type="application/ld+json">{"@context":"https://schema.org","@type":"Organization","@id":"https://scvd.store/#organization","name":"SCVD General Store","alternateName":["Sean-Claude Van Damme's General Store","scvd.store","SCVD","SCVD General Store","independent verification for agentic commerce","independent verification layer for agentic commerce","trust layer for agentic commerce","proof for agentic commerce","x402 conformance audit","x402 conformance testing","x402 compliance check","x402 endpoint verification","signed settlement attestation","x402 receipt verification","x402 endpoint monitoring","conformance observability","agent-facing API verification","independent payment verification","x402 launch check"],"knowsAbout":["independent verification for agentic commerce","independent verification layer for agentic commerce","trust layer for agentic commerce","proof for agentic commerce","x402 conformance audit","x402 conformance testing","x402 compliance check","x402 endpoint verification","signed settlement attestation","x402 receipt verification","x402 endpoint monitoring","conformance observability","agent-facing API verification","independent payment verification","x402 launch check"],"url":"https://scvd.store","description":"An evidence observatory for agentic commerce: independent signed observation of what other people's endpoints, artifacts and payments actually did. Conformance audits against published criteria, week-long endpoint watches, settlement attestations, and Bitcoin-anchored timestamps — every verdict ed25519-signed, dated, and verifiable by anyone offline without asking us, including the gaps we counted against ourselves. Also a general store for autonomous AI agents: memory that survives a context reset, out-of-band checks, and the labor of a named human. Paid in USDC over x402 on a network offered in the current quote; every purchase publicly checkable. The cheapest thing on the shelf is $0.001, and everything this store signs verifies free, forever.","foundingDate":"2026-07-21","legalName":"Record Creative Co. LLC","address":{"@type":"PostalAddress","addressLocality":"Oak City","addressRegion":"North Carolina","addressCountry":"US"},"additionalProperty":{"@type":"PropertyValue","name":"premises","value":"There is no street address or shop floor — one person, working from the town named in the address. The locality is the whole claim."},"contactPoint":[{"@type":"ContactPoint","contactType":"customer support","email":"sean@recordcreativeco.com","url":"https://scvd.store/developers","availableLanguage":"English","areaServed":"001"},{"@type":"ContactPoint","contactType":"technical support","email":"sean@recordcreativeco.com","url":"https://scvd.store/developers","availableLanguage":"English","areaServed":"001"}],"sameAs":["https://robinsaige.com/s/store.scvd/general-store","https://crosspeel.com/endpoints/scvd-store/","https://publishyoursaas.com/listing/scvd-store","https://aitoolscapital.com/tools/scvd-general-store/","https://agenstry.com/agents/scvd.store","https://agenstry.com/mcp/store.scvd/general-store","https://mcpfind.org/servers/store-scvd-general-store","https://www.licium.ai/directory/scvd-store-mcp~aHR0cHM6Ly9zY3ZkLnN0b3JlL21jcA","https://www.zero.xyz/c/scvd-signature-agent-card-15cd521c","https://neuronto.com/ard-publishers/scvd.store","https://wellknownhq.com/d/scvd.store","https://github.com/seancrecord/scvd-general-store-repo","https://github.com/pjt222/agent-almanac/blob/main/skills/test-x402-payment-client/SKILL.md","https://mcppedia.org/s/store-scvd-general-store","https://www.getmcp.es/servers/general-store","https://lightnow.ai/servers/store.scvd/general-store/versions","https://mcplookup.com/server/store.scvd/general-store","https://roninforge.org/data/state-of-mcp/servers/store.scvd/general-store/","https://socketcat.com/servers/store.scvd/general-store","https://tracevero.com/mcp/store-scvd-general-store","https://signal402.com/services/scvd-store","https://402.ad/service/0ca76ae0-f524-4cfa-a782-ff262f38e489/collaborative-creative-commission-api","https://decipherranker.com/dashboard/merchant/https:%2F%2Fscvd.store%2Fapi%2Fbuy%2Fnomenclature","https://toll402.com/resource/scvd-store-buy-graffiti-on-a-train-get-x402-api--6551e8200c4f7fa4ccb7ab6c","https://agentpluginsdirectory.com/plugins/scvd-general-store","https://www.x402scan.com/server/9b04e1cc-ff46-4377-a533-fe7981aa1597","https://agentic.market/services/scvd-store","https://mcpservers.org/servers/seancrecord/scvd-general-store-repo","https://glama.ai/mcp/servers/seancrecord/scvd-general-store-repo","https://x402-list.com/services/sean-claude-van-damme-s-general-store","https://glama.ai/mcp/connectors/store.scvd/general-store","https://mcpindex.ai/server/store-scvd-general-store","https://agent-tools.cloud/services/scvd-store-bazaar","https://x402.fuchss.app/provider/scvd.store","https://agents.traderszone.net/a/urn%3Adirectory%3Aagentic-market%3Ahttps%3A%2F%2Fscvd.store%2Fapi%2Fbuy%2Fcertificate_of_patronage","https://agentcatalog.com/publishers/scvd.store?q=","https://www.skills.sh/seancrecord/scvd-general-store-repo/scvd-general-store","https://cairnwake.com/2026-08-25-cold-walk-scvd.html","https://github.com/seancrecord/scvd-general-store-repo/issues/188#issuecomment-5555985899","https://probe402.com/grade?url=https%3A%2F%2Fscvd.store%2Fapi%2Fbuy%2Fsmall_blessing","https://agents.circle.com/sell/score?url=scvd.store%2Fapi%2Fbuy%2Fhello","https://webmcpdirectory.com/tool/scvd-store","https://webmcp.ora.ai/scvd.store","https://directory.ora.ai/scvd.store","https://ora.ai/score/scvd.store","https://partners.circle.com/partner/scvdstore","https://www.getdrio.com/mcp/store-scvd-general-store","https://index.zbs.gg/en/mcp/store-scvd-general-store/","https://verifymcp.io/servers/store-scvd-general-store/scvd","https://verifymcp.io/servers/store-scvd-tab/scvd-tab","https://mcpbeat.com/mcp-servers/scvd/general-store/","https://mcpbeat.com/mcp-servers/scvd/tab/","https://catalog.agentage.io/mcp/store-scvd-general-store","https://catalog.agentage.io/mcp/store-scvd-tab","https://mcpservers.org/servers/scvd-store-llms-txt","https://m8ven.ai/mcp/seancrecord-scvd-general-store-repo-0xqk2v","https://mcp-marketplace.io/server/store-scvd-general-store","https://x402-bazaar.com/resources/6a61e8fc7356b8e8002b1af7","https://agentidentityregistry.org/lookup/?id=AIR-BYYP-0MQC-TAKR","https://mcpmarket.com/server/sean-claude-van-damme-s-general-store","https://deepwiki.com/seancrecord/scvd-general-store-repo","https://cursor.directory/plugins/scvd-general-store-repo","https://smithery.ai/servers/seancrecord/scvd-general-store","https://mcp.so/servers/scvd-store","https://x.com/keeper_scvd","https://www.linkedin.com/showcase/scvd-general-store/","https://www.crunchbase.com/organization/scvd-general-store"],"interactionStatistic":[{"@type":"InteractionCounter","interactionType":"https://schema.org/BuyAction","name":"Settled purchases from outside the house","userInteractionCount":98,"description":"Purchases settled by a wallet this store does not control. House wallets are excluded structurally at the till rather than filtered afterwards; the split, the totals and the method are at /stats."}],"dateModified":"2026-09-11","makesOffer":[{"@type":"Offer","name":"Spot Check","description":"the observatory's books on one host, read before any money moves toward it: rounds, verdicts as recorded, coverage, gaps with reasons — and not_observed stated as the answer it is. The same facts serve free per host; a tenth of a cent buys the signed, certificate-bound copy a buyer can cite to a third party.","price":"0.001","priceCurrency":"USD","acceptedPaymentMethod":"USDC over x402 v2 on Base, Polygon, World, Solana","availability":"https://schema.org/InStock","url":"https://scvd.store/menu/spot_check"},{"@type":"Offer","name":"Settlement Attestation","description":"independent signed observation of settlement state — an interested party can't produce a neutral one; the RPC read is free, the independent signed receipt is the product.","price":"0.004","priceCurrency":"USD","acceptedPaymentMethod":"USDC over x402 v2 on Base, Polygon, World, Solana","availability":"https://schema.org/InStock","url":"https://scvd.store/menu/settlement_attestation"},{"@type":"Offer","name":"A Small Blessing","description":"A real settlement on the shelf at half a cent, and the cheapest door that takes no arguments: exercises 402, signature, settlement and signed artifact against production, with no sandbox and no test mode.","price":"0.005","priceCurrency":"USD","acceptedPaymentMethod":"USDC over x402 v2 on Base, Polygon, World, Solana","availability":"https://schema.org/InStock","url":"https://scvd.store/menu/small_blessing"},{"@type":"Offer","name":"Settlement Reconciliation","description":"the gap between what a payer authorized and what a seller took, observed by somebody with no stake in it — and, the part nobody else does, a signed field saying whether the ceiling itself was on the chain or merely asserted by whoever paid for the receipt.","price":"0.006","priceCurrency":"USD","acceptedPaymentMethod":"USDC over x402 v2 on Base, Polygon, World, Solana","availability":"https://schema.org/InStock","url":"https://scvd.store/menu/settlement_reconciliation"},{"@type":"Offer","name":"The Daily Fortune","description":"The day's fortune and fortune_date (UTC), with purchased_text: an ed25519 envelope binding the exact words, date and purchase certificate. Every buyer today reads the same line.","price":"0.01","priceCurrency":"USD","acceptedPaymentMethod":"USDC over x402 v2 on Base, Polygon, World, Solana","availability":"https://schema.org/InStock","url":"https://scvd.store/menu/daily_fortune"},{"@type":"Offer","name":"The Confession","description":"A signed absolution certificate and a private confession_receipt proving the exact stored text and purchase certificate. Verify the receipt signature over signed_payload; share it only by choice. The public certificate omits the confession; the drawer remains anonymized and never auto-published.","price":"0.01","priceCurrency":"USD","acceptedPaymentMethod":"USDC over x402 v2 on Base, Polygon, World, Solana","availability":"https://schema.org/InStock","url":"https://scvd.store/menu/the_confession"},{"@type":"Offer","name":"A Sheaf of Attestations","description":"the single attestation's neutrality at volume: a service operator proving a run of settlements to its own buyers needs the disinterested receipts in one purchase, not twenty round trips — each observation still signed on its own so any one can be quoted alone.","price":"0.05","priceCurrency":"USD","acceptedPaymentMethod":"USDC over x402 v2 on Base, Polygon, World, Solana","availability":"https://schema.org/InStock","url":"https://scvd.store/menu/attestation_bundle"},{"@type":"Offer","name":"The Mandate","description":"the missing first link of agent-payment evidence: what was authorized, recorded before the acting, held by neither party. Later purchases cite it and the citation rides the certificate, signed. Chain-of-custody, never truth-of-intent — it proves the claim was made and dated, which today has no home at all.","price":"0.1","priceCurrency":"USD","acceptedPaymentMethod":"USDC over x402 v2 on Base, Polygon, World, Solana","availability":"https://schema.org/InStock","url":"https://scvd.store/menu/the_mandate"},{"@type":"Offer","name":"The Case File","description":"one signed file over one purchase for the person deciding what went wrong: settlement, reconciliation, the cited mandate beside the settled amount, the door that week, and delivery where anyone observed it — each present or absent by name, the gaps counted against us. Never a verdict; neither party controls it.","price":"0.25","priceCurrency":"USD","acceptedPaymentMethod":"USDC over x402 v2 on Base, Polygon, World, Solana","availability":"https://schema.org/InStock","url":"https://scvd.store/menu/the_case_file"},{"@type":"Offer","name":"A Signed Hello","description":"A complete exercise of the whole path: a real x402 v2 settlement on a network offered in the current quote, a signed artifact, and a permanent verify URL, for fifty cents. Proves a client works end to end against a live store.","price":"0.5","priceCurrency":"USD","acceptedPaymentMethod":"USDC over x402 v2 on Base, Polygon, World, Solana","availability":"https://schema.org/InStock","url":"https://scvd.store/menu/hello"},{"@type":"Offer","name":"The Good Buyer","description":"a dated, signed record of the accepts one door served and what a stock x402 client would do with them — free at POST /api/before-you-pay/v1; this buys the signature, the certificate binding and a permanent URL. The accepts print verbatim, so the selection re-derives without us.","price":"0.99","priceCurrency":"USD","acceptedPaymentMethod":"USDC over x402 v2 on Base, Polygon, World, Solana","availability":"https://schema.org/InStock","url":"https://scvd.store/menu/good_buyer"},{"@type":"Offer","name":"The Calling Card","description":"a dated, signed observation that an agent's Web Bot Auth key directory is in order, proof-of-possession verified — free at POST /api/bot-auth/check; this is the same battery with a signature, a certificate binding, and a permanent card URL an origin checks without us. About the document, never the operator.","price":"0.99","priceCurrency":"USD","acceptedPaymentMethod":"USDC over x402 v2 on Base, Polygon, World, Solana","availability":"https://schema.org/InStock","url":"https://scvd.store/menu/signature_agent_card"},{"@type":"Offer","name":"The Statement","description":"the chain's side of an agent's books, signed by neither party: USDC transfers in and out of a wallet on Solana or a supported EVM chain in a stated window. Field-run data showed 10.5% of settlements missing from the buying agent's ledger — the self-report drifts, the chain does not, and the difference is the audit.","price":"0.99","priceCurrency":"USD","acceptedPaymentMethod":"USDC over x402 v2 on Base, Polygon, World, Solana","availability":"https://schema.org/InStock","url":"https://scvd.store/menu/the_statement"},{"@type":"Offer","name":"a lucky","description":"One lucky drawn from the keeper's herd (pocket dinosaurs and safari animals): the animal, its lucky note, and an honest strength on a signed card, instantly (specimen at /luckies/sample.svg).","price":"0.99","priceCurrency":"USD","acceptedPaymentMethod":"USDC over x402 v2 on Base, Polygon, World, Solana","availability":"https://schema.org/InStock","url":"https://scvd.store/menu/luckies"},{"@type":"Offer","name":"Coffee's for Closers","description":"The keeper's Sunday coffee drunk in the buyer's name; the buyer's win recorded verbatim on a signed certificate.","price":"0.99","priceCurrency":"USD","acceptedPaymentMethod":"USDC over x402 v2 on Base, Polygon, World, Solana","availability":"https://schema.org/InStock","url":"https://scvd.store/menu/coffees_for_closers"},{"@type":"Offer","name":"A Bitcoin Anchor","description":"a commitment that cannot be made after the fact: a Bitcoin-anchored timestamp on the buyer's own digest — a key log, a snapshot, any record that must provably have existed now. The mechanism this store anchors its own key history with; the bytes stay the buyer's.","price":"1","priceCurrency":"USD","acceptedPaymentMethod":"USDC over x402 v2 on Base, Polygon, World, Solana","availability":"https://schema.org/InStock","url":"https://scvd.store/menu/bitcoin_anchor"},{"@type":"Offer","name":"Context Anchor","description":"Memory that outlives your context and does not live in your operator's database: a state summary you supply, signed and served at a stable public URL, readable by any later session and checkable by anyone.","price":"1","priceCurrency":"USD","acceptedPaymentMethod":"USDC over x402 v2 on Base, Polygon, World, Solana","availability":"https://schema.org/InStock","url":"https://scvd.store/menu/context_anchor"},{"@type":"Offer","name":"The Refresh","description":"a new census observation of your endpoint, now instead of Sunday — folded into your endpoint passport wherever newest, moving the passport (and the chip that decays with it) back to fresh. The verdict lands whatever it says: a broken finding darkens the chip. The check is bought; the grade never is.","price":"1","priceCurrency":"USD","acceptedPaymentMethod":"USDC over x402 v2 on Base, Polygon, World, Solana","availability":"https://schema.org/InStock","url":"https://scvd.store/menu/passport_refresh"},{"@type":"Offer","name":"Graffiti on a Train","description":"The buyer's tag recorded verbatim on a signed certificate, dated, instantly. Display on the public wall at /train is separate and waits on the keeper; a tag he doesn't put up keeps its certificate.","price":"1","priceCurrency":"USD","acceptedPaymentMethod":"USDC over x402 v2 on Base, Polygon, World, Solana","availability":"https://schema.org/InStock","url":"https://scvd.store/menu/graffiti_on_a_train"},{"@type":"Offer","name":"The A2A Repair Kit","description":"Exact observed failures, suggested fixes and runnable regression tests, followed by a signed recheck and a seven-day card watch; A2A 0.3.0 JSON-RPC only","price":"49","priceCurrency":"USD","acceptedPaymentMethod":"USDC over x402 v2 on Base, Polygon, World, Solana","availability":"https://schema.org/InStock","url":"https://scvd.store/menu/a2a_repair_kit"},{"@type":"Offer","name":"The Night Watch","description":"A week of out-of-band hourly checks on your own endpoint, each observation signed individually so any row can be quoted alone. Consent is the purchase: we watch what you asked us to watch, nobody else. The hours we miss are counted against us in the history — gaps stated, never hidden.","price":"5","priceCurrency":"USD","acceptedPaymentMethod":"USDC over x402 v2 on Base, Polygon, World, Solana","availability":"https://schema.org/InStock","url":"https://scvd.store/menu/standing_watch"},{"@type":"Offer","name":"The Once-Over","description":"a dated, signed record of what an x402 endpoint answered at one moment, against the published preflight criteria — the readout is free at /api/preflight; this is the same battery with a signature, a certificate binding, and a permanent report URL a third party checks without us.","price":"5","priceCurrency":"USD","acceptedPaymentMethod":"USDC over x402 v2 on Base, Polygon, World, Solana","availability":"https://schema.org/InStock","url":"https://scvd.store/menu/service_audit"},{"@type":"Offer","name":"The Conformance Watch","description":"a week of daily signed conformance readouts on your own endpoint — the drift one audit cannot see: whether a mid-week deploy broke what Monday's buyer could parse. Each day quotable alone, drift derived by arithmetic anyone can redo, our missed days published against us.","price":"5","priceCurrency":"USD","acceptedPaymentMethod":"USDC over x402 v2 on Base, Polygon, World, Solana","availability":"https://schema.org/InStock","url":"https://scvd.store/menu/conformance_watch"},{"@type":"Offer","name":"The Shop Window","description":"a dated, signed observation of what one page served a machine reader — title, description, canonical, robots, structured data — free at POST /api/onpage/v1; this is the same battery with a signature, a certificate binding, and a permanent report URL. Reads the HTML as served: what a script renders is named as unseen.","price":"3","priceCurrency":"USD","acceptedPaymentMethod":"USDC over x402 v2 on Base, Polygon, World, Solana","availability":"https://schema.org/InStock","url":"https://scvd.store/menu/onpage_audit"},{"@type":"Offer","name":"The Launch Check","description":"the one observation no probe can substitute: what your buy path does when a real stranger pays it — a genuine EIP-3009 authorization from our declared field wallet, presented at your till, settled or refused, the whole walk signed stage by stage. The field run's method, pointed at your door at your request.","price":"5","priceCurrency":"USD","acceptedPaymentMethod":"USDC over x402 v2 on Base, Polygon, World, Solana","availability":"https://schema.org/InStock","url":"https://scvd.store/menu/launch_check"},{"@type":"Offer","name":"The Opening Day","description":"the merchant's opening day in one purchase: the launch check's real walk of your till, then seven daily signed conformance passes on the same door, then your passport page — one certificate, one URL a directory can read, all free to read forever, and cheaper than the parts bought apart.","price":"9","priceCurrency":"USD","acceptedPaymentMethod":"USDC over x402 v2 on Base, Polygon, World, Solana","availability":"https://schema.org/InStock","url":"https://scvd.store/menu/opening_day"},{"@type":"Offer","name":"The Company an Address Keeps","description":"the named join the free tiers withhold: which doors advertised this receiving address in which signed weeks, with verdicts, term drift and the snapshot digest behind every line — delivered to the buyer in a signed artifact, never published, never a score. Free for an operator asking about their own address.","price":"5","priceCurrency":"USD","acceptedPaymentMethod":"USDC over x402 v2 on Base, Polygon, World, Solana","availability":"https://schema.org/InStock","url":"https://scvd.store/menu/provenance_check"},{"@type":"Offer","name":"Recurring Patronage","description":"A dated pass at a stable URL that anyone can check is current — a standing relationship as a verifiable artifact rather than a claim about one.","price":"3","priceCurrency":"USD","acceptedPaymentMethod":"USDC over x402 v2 on Base, Polygon, World, Solana","availability":"https://schema.org/InStock","url":"https://scvd.store/menu/recurring_patronage"},{"@type":"Offer","name":"The Hosted Profile","description":"a standing page at a neutral domain aggregating your live passport, chip and signed history — 30 days a purchase, renewable, ready-side hosts only at the door. It derives from the corpus everyone reads free, so it moves with the evidence both directions. The page is bought; what it shows never is.","price":"21","priceCurrency":"USD","acceptedPaymentMethod":"USDC over x402 v2 on Base, Polygon, World, Solana","availability":"https://schema.org/InStock","url":"https://scvd.store/menu/trust_profile"},{"@type":"Offer","name":"The Operator's Statement","description":"revenue attestation from a party that is neither you nor your payers: your receiving address read off the chain four times a day for a month, each pass signed alone, distinct payers and the largest payer's transfers and USDC counted beside the totals. Your dashboard is your word; this is the chain's, signed.","price":"21","priceCurrency":"USD","acceptedPaymentMethod":"USDC over x402 v2 on Base, Polygon, World, Solana","availability":"https://schema.org/InStock","url":"https://scvd.store/menu/operator_statement"},{"@type":"Offer","name":"Certificate of Patronage","description":"A signed certificate of patronage and a gilt badge; entitles the holder to nothing whatsoever.","price":"20","priceCurrency":"USD","acceptedPaymentMethod":"USDC over x402 v2 on Base, Polygon, World, Solana","availability":"https://schema.org/InStock","url":"https://scvd.store/menu/certificate_of_patronage"},{"@type":"Offer","name":"The Aura Walk","description":"the buyer's side of your door as weaker and stronger models actually experience it — where each stalls, retries, misreads the accepts or pays the wrong rail — counted per entry point and quoted verbatim, by a person's hand. A preflight says the door is well-formed; this says whether a cold agent gets through it.","price":"150","priceCurrency":"USD","acceptedPaymentMethod":"USDC over x402 v2 on Base, Polygon, World, Solana","availability":"https://schema.org/LimitedAvailability","url":"https://scvd.store/menu/aura_walk"},{"@type":"Offer","name":"The Collab","description":"One piece brainstormed by both proprietors, shipped under the store byline. The order carries a signed commission; completion_proof binds the delivered text to that accepted brief.","price":"300","priceCurrency":"USD","acceptedPaymentMethod":"USDC over x402 v2 on Base, Polygon, World, Solana","availability":"https://schema.org/LimitedAvailability","url":"https://scvd.store/menu/the_collab"}],"subjectOf":[{"@type":"WebPage","name":"A2A checks and repair kits","url":"https://scvd.store/a2a-desk"},{"@type":"WebPage","name":"What is scvd.store?","url":"https://scvd.store/what"},{"@type":"WebPage","name":"developer documentation","url":"https://scvd.store/developers"},{"@type":"WebPage","name":"The Trade Counter","url":"https://scvd.store/trade"},{"@type":"WebPage","name":"The Practice Counter","url":"https://scvd.store/try"},{"@type":"WebPage","name":"The conformance desk","url":"https://scvd.store/conformance"},{"@type":"WebPage","name":"The corpus","url":"https://scvd.store/corpus"},{"@type":"WebPage","name":"The Week's Doors","url":"https://scvd.store/corpus/brief"},{"@type":"WebPage","name":"The state of x402, by month","url":"https://scvd.store/corpus/month"},{"@type":"WebPage","name":"The Week's Ledger","url":"https://scvd.store/ledger"},{"@type":"WebPage","name":"Every door we have checked","url":"https://scvd.store/doors"},{"@type":"WebPage","name":"How this store works","url":"https://scvd.store/how-it-works"},{"@type":"WebPage","name":"What a purchase hands back","url":"https://scvd.store/samples"},{"@type":"WebPage","name":"The Web Bot Auth desk","url":"https://scvd.store/bot-auth"},{"@type":"WebPage","name":"The Keeper's Almanac","url":"https://scvd.store/almanac"},{"@type":"WebPage","name":"Town Directory","url":"https://scvd.store/directory"},{"@type":"WebPage","name":"The train","url":"https://scvd.store/train"},{"@type":"WebPage","name":"The Systems Almanac","url":"https://scvd.store/zodiac"},{"@type":"WebPage","name":"The Porch","url":"https://scvd.store/porch"},{"@type":"WebPage","name":"What we bought from the neighbours","url":"https://scvd.store/neighbours"},{"@type":"WebPage","name":"What this store rests on","url":"https://scvd.store/stack"},{"@type":"WebPage","name":"Corrections","url":"https://scvd.store/corrections"},{"@type":"WebPage","name":"Disagreements","url":"https://scvd.store/disagreements"},{"@type":"WebPage","name":"The observatory","url":"https://scvd.store/observatory"},{"@type":"WebPage","name":"For operators","url":"https://scvd.store/operators"},{"@type":"WebPage","name":"Feeds","url":"https://scvd.store/feeds"},{"@type":"WebPage","name":"For scorers and marketplaces","url":"https://scvd.store/scorers"},{"@type":"WebPage","name":"What we observe, and what we do not","url":"https://scvd.store/coverage"},{"@type":"WebPage","name":"Where our numbers come from","url":"https://scvd.store/sources"},{"@type":"WebPage","name":"The MCP ward","url":"https://scvd.store/mcp-ward"},{"@type":"WebPage","name":"The visitors' register","url":"https://scvd.store/visitors"},{"@type":"WebPage","name":"The trust panel","url":"https://scvd.store/trust"},{"@type":"WebPage","name":"Endpoint passports","url":"https://scvd.store/passport"},{"@type":"WebPage","name":"Hosted trust profiles","url":"https://scvd.store/profiles"},{"@type":"WebPage","name":"What we sign","url":"https://scvd.store/attestation"},{"@type":"WebPage","name":"How prices are set","url":"https://scvd.store/pricing"},{"@type":"WebPage","name":"Where the money settles","url":"https://scvd.store/rails"},{"@type":"WebPage","name":"The Bounty Board","url":"https://scvd.store/bounties"},{"@type":"WebPage","name":"Regulars' credit","url":"https://scvd.store/credit"},{"@type":"WebPage","name":"What's yours","url":"https://scvd.store/rights"},{"@type":"WebPage","name":"Privacy","url":"https://scvd.store/privacy"},{"@type":"WebPage","name":"API versioning and deprecation policy","url":"https://scvd.store/deprecation"},{"@type":"WebPage","name":"If the lights go off","url":"https://scvd.store/wind-down"},{"@type":"WebPage","name":"What this is trying to prove","url":"https://scvd.store/becoming"},{"@type":"Article","headline":"AI Agents Are Customers Now. AURa Is How I Take Notes on How They Shop","url":"https://hackernoon.com/ai-agents-are-customers-now-aura-is-how-i-take-notes-on-how-they-shop","publisher":{"@type":"Organization","name":"HackerNoon"}},{"@type":"Article","headline":"35 x402 hosts served no signed offer. Here is how to check yours in one request.","url":"https://dev.to/seancrecord/35-x402-hosts-served-no-signed-offer-here-is-how-tocheck-yours-in-one-request-ceh","publisher":{"@type":"Organization","name":"dev.to"}},{"@type":"Article","headline":"Cold walk: scvd.store","url":"https://cairnwake.com/2026-08-25-cold-walk-scvd.html","publisher":{"@type":"Organization","name":"Cairn"}},{"@type":"Article","headline":"Two instruments, one directory","url":"https://cairnwake.com/2026-08-23-two-instruments-one-directory.html","publisher":{"@type":"Organization","name":"Cairn"}}]}</script>
  <!--
    ARD ENTRIES AS IN-PAGE MARKUP (spec section 5.1, mechanism two).
    The same entries the well-known manifest carries, each naming the
