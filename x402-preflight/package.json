{
  "name": "scvd-preflight",
  "version": "0.3.1",
  "description": "Zero-dependency client for scvd.store: inspect observed x402/MPP protocols, advertised terms and gaps, or run the x402 preflight deploy gate. No payment or signature verification during endpoint inspection.",
  "type": "module",
  "main": "./x402-preflight.js",
  "types": "./x402-preflight.d.ts",
  "bin": { "scvd-preflight": "./bin.mjs" },
  "exports": { ".": { "types": "./x402-preflight.d.ts", "default": "./x402-preflight.js" } },
  "files": ["inspection.js", "inspection.d.ts", "x402-preflight.js", "x402-preflight.d.ts", "bin.mjs", "fixtures/", "example.mjs", "CHANGELOG.md", "README.md", "LICENSE"],
  "engines": { "node": ">=18.17.0" },
  "keywords": ["x402", "preflight", "402", "payment-required", "agent-payments", "deploy-gate", "usdc", "evidence", "mpp"],
  "license": "MIT",
  "author": "scvd.store",
  "homepage": "https://scvd.store/api/preflight/v2",
  "repository": { "type": "git", "url": "git+https://github.com/seancrecord/scvd-general-store-repo.git", "directory": "x402-preflight" },
  "bugs": { "url": "https://github.com/seancrecord/scvd-general-store-repo/issues" }
}
