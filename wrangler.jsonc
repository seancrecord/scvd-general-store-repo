// Sean-Claude Van Damme's General Store — Worker configuration.
// Deploys to the scvd.store custom domain via Git-connected builds.
{
  /**
   * Markdown ships as a Text module. CV's research trails live as .md
   * in research/ so he can append to them like a notebook; esbuild has
   * no .md loader without this, and a `?raw` import — which vite serves
   * in tests — fails the real build. Found 2026-07-30 when the deploy
   * broke and the tests didn't.
   */
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scvd-general-store-repo",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  /**
   * CPU ceiling, tracked here so a git-connected build cannot silently
   * diverge from what was set by hand in the dashboard (config states
   * itself — AT_SCALE rule 4). 100ms is generous for this Worker:
   * CPU time counts COMPUTE ONLY, and Ed25519 signing via @noble is
   * sub-millisecond even for the three-sign offer path, while every
   * KV read, facilitator round-trip, and Base RPC call is I/O that
   * does not count against this at all. The one path that is genuinely
   * CPU-bound is the admin census/recount in-memory row walk — capped,
   * Basic-Auth-only, and the first thing to watch if a scan ever
   * trips the ceiling. Once tracked here, THIS file is the source of
   * truth: raise the limit here, not in the dashboard.
   */
  "limits": { "cpu_ms": 100 },
  "routes": [
    { "pattern": "scvd.store", "custom_domain": true }
  ],
  // Weekly digest: Sundays 7am ET (11:00 UTC during daylight time).
  // Hourly: the phantom-check walk (due out-of-band probes).
  "triggers": {
    "crons": ["0 11 * * SUN", "30 * * * *"]
  },
  // KV namespaces. Create them once with:
  //   wrangler kv namespace create ORDERS
  //   wrangler kv namespace create GUESTBOOK
  //   wrangler kv namespace create COUNTERS
  //   wrangler kv namespace create PATRONS
  // then paste the ids below.
  "kv_namespaces": [
    { "binding": "ORDERS", "id": "4a23f9dd93f4434aad98295e592c8805" },
    { "binding": "GUESTBOOK", "id": "93c5a5a59fbe4fa6ad96ed9af3852d70" },
    { "binding": "COUNTERS", "id": "bc1397211dbd4b30876edb76b45a1142" },
    { "binding": "PATRONS", "id": "b3b7dc0f951f4b4a9995afe7dc35e015" }
  ],
  "vars": {
    "STORE_BASE_URL": "https://scvd.store",
    // Settlement attestation reads Base once per purchase. The public
    // endpoint is fine at this volume; swap it the day it isn't. Not a
    // secret — it is a public RPC URL, and the store reads only.
    "BASE_RPC_URL": "https://mainnet.base.org"
  }
  // Secrets (never in this file — set via `wrangler secret put <NAME>`):
  //   PAY_TO_ADDRESS      Base wallet that receives USDC
  //   CDP_API_KEY_ID      Coinbase Developer Platform key id (facilitator auth)
  //   CDP_API_KEY_SECRET  Coinbase Developer Platform key secret
  //   SIGNING_KEY         ed25519 private key seed, 64 hex chars (npm run keys:generate)
  //   ADMIN_PASSWORD      Basic Auth password for /admin
  //   SOLANA_PAY_TO       Solana wallet that receives USDC (second rail; unset = rail closed)
}
