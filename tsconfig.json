{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": [
      "@cloudflare/workers-types",
      "@cloudflare/vitest-pool-workers/types",
      "node"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    /*
     * NO baseUrl, AND THE ALIAS IS RELATIVE ON PURPOSE. TypeScript 7
     * removes baseUrl (TS5102) and rejects non-relative path targets
     * (TS5090). 5.9 accepts this form too, so it is written the
     * forward-compatible way now and the major becomes a one-line
     * change in package.json rather than a config migration.
     *
     * TS 7 ITSELF IS NOT INSTALLED, and the reason is upstream rather
     * than ours (2026-08-24). The code compiles and the whole suite
     * passes under 7.0.2 — but @solana/kit@5.5.1 declares
     * peerOptional typescript@"^5.0.0", which 7.x does not satisfy,
     * so `npm ci` refuses to resolve the tree even though `npm
     * install` will. When that peer range widens, bump and delete
     * this paragraph.
     */
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts"]
}
