{
  "name": "scvd-cli",
  "version": "0.5.0",
  "description": "The official command line for scvd.store: inspect x402/MPP endpoints, check signed offers and receipts, read the observation corpus, and verify store artifacts. Zero dependencies; no account or key.",
  "type": "module",
  "bin": {
    "scvd": "scvd.mjs"
  },
  "main": "./scvd.mjs",
  "files": [
    "scvd.mjs",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "inspection.js"
  ],
  "engines": {
    "node": ">=18.17.0"
  },
  "keywords": [
    "x402",
    "cli",
    "conformance",
    "preflight",
    "agent-payments",
    "usdc",
    "verification",
    "scvd",
    "mpp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seancrecord/scvd-general-store-repo.git",
    "directory": "cli"
  },
  "license": "MIT",
  "author": "scvd.store",
  "homepage": "https://scvd.store/developers"
}
