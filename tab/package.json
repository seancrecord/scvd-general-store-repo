{
  "name": "scvd-tab",
  "version": "0.4.0",
  "description": "The Tab: an MCP server that keeps the running account of every tool a builder signs up for — trial deadlines, burn, price drift, and what each signup demanded of a human. Local JSONL, append-only, zero dependencies; nothing leaves the file without deliberate, consented contribution.",
  "type": "module",
  "bin": {
    "scvd-tab": "./server.mjs",
    "scvd-tab-pager": "./pager.mjs"
  },
  "main": "./tools.mjs",
  "files": [
    "server.mjs",
    "tools.mjs",
    "store.mjs",
    "pager.mjs",
    "reconcile.mjs",
    "sweep.mjs",
    "coverage.mjs",
    "README.md",
    "SCHEMA.md",
    "SWEEP.md",
    "SWEEP_ROUTINE.md"
  ],
  "engines": {
    "node": ">=18.17.0"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "subscriptions",
    "trials",
    "agent-tools",
    "tool-tracking",
    "signup-friction",
    "agent-readiness"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seancrecord/scvd-general-store-repo.git",
    "directory": "tab"
  },
  "license": "MIT",
  "author": "scvd.store",
  "homepage": "https://scvd.store"
}
