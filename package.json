{
  "name": "scvd-general-store",
  "mcpName": "store.scvd/general-store",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Sean-Claude Van Damme's General Store — a human-run shop for autonomous AI agents.",
  "homepage": "https://scvd.store",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seancrecord/scvd-general-store-repo.git"
  },
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "gates": "npm run typecheck && npm run self-row && npm test && npm run tab:test && npm run till:test && npm run cli:test && npm run doors:test && npm run walkabout:test && npm run audit && npm run claims && npm run docs:check && npm run build:check",
    "self-row": "vitest run test/self-row-blocker.spec.ts",
    "typecheck": "tsc --noEmit",
    "keys:generate": "node scripts/generate-signing-key.mjs",
    "keys:check": "node scripts/check-key-transcription.mjs",
    "shop": "node scripts/shopping-run.mjs",
    "bazaar:check": "node scripts/bazaar-check.mjs",
    "wba:check": "node scripts/wba-check.mjs",
    "audit": "node scripts/audit.mjs",
    "claims": "node scripts/claims.mjs",
    "skill:publish": "node scripts/publish-skill.mjs",
    "build:check": "wrangler deploy --dry-run --outdir .build-check",
    "bazaar:validate": "node scripts/bazaar-validate.mjs",
    "census": "node scripts/x402-census.mjs",
    "supported:kinds": "node scripts/supported-kinds.mjs",
    "agentic:check": "node scripts/agentic-market-check.mjs",
    "probe:dead-mcp": "node scripts/dead-mcp-probe.mjs",
    "tab:test": "node --test tab/tab.test.mjs",
    "till:test": "node --test till/till.test.mjs",
    "cli:test": "node --test cli/cli.test.mjs",
    "doors:check": "node scripts/doors-check.mjs",
    "doors:test": "node --test scripts/doors-check.test.mjs",
    "walkabout": "node scripts/walkabout.mjs",
    "walkabout:test": "node --test scripts/walkabout.test.mjs",
    "tab:pager": "node tab/pager.mjs",
    "docs:check": "node scripts/docs-check.mjs"
  },
  "dependencies": {
    "@coinbase/x402": "^2.1.0",
    "@noble/ed25519": "^3.1.0",
    "@x402/core": "^2.23.0",
    "@x402/evm": "^2.23.0",
    "@x402/extensions": "^2.23.0",
    "@x402/hono": "^2.23.0",
    "@x402/svm": "~2.23.0",
    "hono": "^4.13.5",
    "viem": "^2.56.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260721.1",
    "@types/node": "^26.2.0",
    "@x402/fetch": "^2.23.0",
    "dotenv": "^17.4.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  },
  "overrides": {
    "axios": "^1.19.0",
    "undici": "^7.29.0"
  }
}
