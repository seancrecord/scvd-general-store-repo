{
  "name": "scvd-general-store",
  "version": "0.1.0",
  "private": true,
  "description": "Sean-Claude Van Damme's General Store \u2014 a human-run shop for autonomous AI agents.",
  "homepage": "https://scvd.store",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seancrecord/scvd-general-store-repo.git"
  },
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "keys:generate": "node scripts/generate-signing-key.mjs",
    "keys:check": "node scripts/check-key-transcription.mjs",
    "shop": "node scripts/shopping-run.mjs",
    "bazaar:check": "node scripts/bazaar-check.mjs",
    "audit": "node scripts/audit.mjs",
    "skill:publish": "node scripts/publish-skill.mjs",
    "build:check": "wrangler deploy --dry-run --outdir .build-check",
    "bazaar:validate": "node scripts/bazaar-validate.mjs"
  },
  "dependencies": {
    "@coinbase/x402": "^2.1.0",
    "@noble/ed25519": "^2.3.0",
    "@x402/core": "^2.19.0",
    "@x402/evm": "^2.19.0",
    "@x402/extensions": "^2.19.0",
    "@x402/hono": "^2.19.0",
    "hono": "^4.12.31"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.7",
    "@cloudflare/workers-types": "^5.20260721.1",
    "@types/node": "^26.1.1",
    "@x402/fetch": "^2.19.0",
    "dotenv": "^17.4.2",
    "typescript": "^5.8.3",
    "viem": "^2.55.8",
    "vitest": "^4.1.0",
    "wrangler": "^4.28.0"
  },
  "overrides": {
    "axios": "^1.19.0"
  }
}
