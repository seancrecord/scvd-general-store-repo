{
  "name": "scvd-general-store",
  "mcpName": "store.scvd/general-store",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Sean-Claude Van Damme's General Store \u2014 a human-run shop for autonomous AI agents.",
  "homepage": "https://scvd.store",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seancrecord/scvd-general-store-repo.git"
  },
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy && node scripts/indexnow-ping.mjs",
    "indexnow": "node scripts/indexnow-ping.mjs",
    "test": "vitest run",
    "gates": "npm run typecheck && npm run self-row && npm test && npm run tab:test && npm run evidence:test && npm run till:test && npm run cli:test && npm run examples:test && npm run packages:test && npm run doors:test && npm run specs:test && npm run listings:test && npm run cold:test && npm run doors:test && npm run corpus:publish:test && npm run citations:test && npm run corrections:test && npm run outreach:test && npm run walkabout:test && npm run audit && npm run claims && npm run docs:check && npm run build:check",
    "self-row": "vitest run test/self-row-blocker.spec.ts",
    "typecheck": "tsc --noEmit",
    "a2a:validation:build": "node scripts/a2a-validation-build.mjs",
    "a2a:check": "node scripts/a2a-validation-build.mjs --check && node --test scripts/a2a-live.test.mjs && vitest run test/a2a-compliance.spec.ts test/a2a-evidence.spec.ts test/a2a-tasks.spec.ts",
    "a2a:live": "node scripts/a2a-live.mjs",
    "keys:generate": "node scripts/generate-signing-key.mjs",
    "keys:check": "node scripts/check-key-transcription.mjs",
    "keys:check:wba": "node scripts/check-wba-key.mjs",
    "shop": "node scripts/shopping-run.mjs",
    "bazaar:check": "node scripts/bazaar-check.mjs",
    "wba:check": "node scripts/wba-check.mjs",
    "audit": "node scripts/audit.mjs",
    "claims": "node scripts/claims.mjs",
    "skill:publish": "node scripts/publish-skill.mjs",
    "build:check": "wrangler deploy --dry-run --outdir .build-check && wrangler deploy --dry-run -c doors/wrangler.jsonc --outdir .build-check-doors",
    "bazaar:validate": "node scripts/bazaar-validate.mjs",
    "census": "node scripts/x402-census.mjs",
    "supported:kinds": "node scripts/supported-kinds.mjs",
    "agentic:check": "node scripts/agentic-market-check.mjs",
    "probe:dead-mcp": "node scripts/dead-mcp-probe.mjs",
    "tab:test": "node --test tab/tab.test.mjs",
    "till:test": "node --test till/till.test.mjs webmcp/purchase.test.mjs",
    "cli:test": "node --test cli/cli.test.mjs",
    "action:test": "node --test action/preflight/preflight.test.mjs",
    "examples:test": "for f in examples/*/agent.mjs examples/shared/decide.mjs; do node --check \"$f\" || exit 1; done && python3 -m py_compile examples/*/agent.py examples/shared/decide.py && node --test examples/shared/decide.test.mjs && (cd examples/shared && python3 -m unittest -q test_decide)",
    "doors:check": "node scripts/doors-check.mjs",
    "specs:check": "node scripts/specs-check.mjs",
    "specs:test": "node --test scripts/specs-check.test.mjs",
    "doors:test": "node --test scripts/doors-config.test.mjs scripts/doors-live.test.mjs scripts/doors-check.test.mjs",
    "listings:check": "node scripts/listings-check.mjs",
    "listings:test": "node --test scripts/listings-check.test.mjs",
    "corpus:publish": "node scripts/corpus-publish.mjs",
    "corpus:publish:test": "node --test scripts/corpus-publish.test.mjs",
    "citations:check": "node scripts/citations-check.mjs",
    "citations:test": "node --test scripts/citations-check.test.mjs",
    "outreach:build": "node scripts/build-scorers-outreach.mjs",
    "outreach:check": "node scripts/outreach-check.mjs",
    "outreach:test": "node --test scripts/scorers-outreach.test.mjs",
    "walkabout": "node scripts/walkabout.mjs",
    "walk-ledger:verify": "node scripts/walk-ledger-verify.mjs",
    "walkabout:test": "node --test scripts/walkabout.test.mjs scripts/field-reconciliation.test.mjs scripts/walk-budget.test.mjs",
    "tab:pager": "node tab/pager.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "packages:test": "for d in x402-preflight corpus-client defects mcp-starter; do (cd \"$d\" && node --test) || exit 1; done",
    "defects:cut": "node scripts/cut-defects.mjs",
    "outreach:sent": "node scripts/outreach-sent.mjs",
    "corrections:index": "node scripts/corrections-index.mjs",
    "corrections:test": "node --test scripts/corrections-index.test.mjs",
    "cold:read": "node scripts/cold-read.mjs",
    "cold:test": "node --test scripts/cold-read.test.mjs",
    "cold:local": "node scripts/cold-local.mjs",
    "deploy:doors": "wrangler deploy -c doors/wrangler.jsonc",
    "doors:live": "node scripts/doors-live.mjs",
    "a2a:runner:build": "node scripts/a2a-runner-build.mjs",
    "a2a:runner:check": "node scripts/a2a-runner-build.mjs --check",
    "a2a:runner:test": "node --test scripts/a2a-runner.test.mjs",
    "evidence:test": "node --test verifier/*.test.mjs experiments/pqc/envelope.test.mjs scripts/evidence-coverage.test.mjs"
  },
  "dependencies": {
    "@coinbase/x402": "^2.1.0",
    "@noble/ed25519": "^3.2.0",
    "@x402/core": "^2.25.0",
    "@x402/evm": "^2.25.0",
    "@x402/extensions": "^2.25.0",
    "@x402/hono": "^2.25.0",
    "@x402/svm": "~2.25.0",
    "hono": "^4.13.7",
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260905.1",
    "@types/node": "^26.2.0",
    "@x402/fetch": "^2.25.0",
    "ajv": "^8.20.0",
    "dotenv": "^17.4.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.0"
  },
  "overrides": {
    "axios": "^1.19.0",
    "undici": "^7.29.0"
  }
}
