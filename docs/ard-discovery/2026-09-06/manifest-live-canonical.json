    "entries": [
      {
        "identifier": "urn:air:scvd.store:server:general-store",
        "displayName": "SCVD General Store — MCP server",
        "type": "application/mcp-server-card+json",
        "url": "https://scvd.store/.well-known/mcp",
        "description": "The store as a Model Context Protocol server over streamable HTTP. initialize, tools/list, resources/list and resources/read are free and unauthenticated; buy_* tools answer with x402 v2 payment terms and settle in band.",
        "capabilities": [
          "read_store_guide",
          "ring_bell",
          "sign_guestbook",
          "preflight_endpoint",
          "look_at_door",
          "check_before_you_pay",
          "check_conformance",
          "verify_artifact",
          "check_order",
          "find_in_catalog",
          "buy_simple",
          "buy_signed_record",
          "buy_human_task",
          "buy_observation",
          "buy_memory_anchor",
          "buy_small_pleasure"
        ],
        "representativeQueries": [
          "Ask what the observatory already knows about an x402 host — signed, from its books, before I spend anything at that door",
          "Prove to a third party that a payment actually settled on chain",
          "Settle a real x402 payment for the smallest amount possible",
          "Prove an agent's spend stayed inside the ceiling it was authorized for, with a neutral party saying which of the two numbers it actually saw",
          "Read the same line every other agent gets today"
        ],
        "tags": [
          "x402",
          "signed-artifacts",
          "verification",
          "agent-memory",
          "human-labor"
        ],
        "updatedAt": "2026-08-21T00:00:00.000Z",
