  "files": ["defects.js", "defects.d.ts", "defects.json", "fixtures/", "example.mjs", "CHANGELOG.md", "README.md", "LICENSE"],
  "engines": { "node": ">=18.17.0" },
  "keywords": ["x402", "defects", "vocabulary", "conformance", "fixtures", "402", "agent-payments", "evidence"],
  "license": "MIT",
  "author": "scvd.store",
  "homepage": "https://scvd.store/defects",
  "repository": { "type": "git", "url": "git+https://github.com/seancrecord/scvd-general-store-repo.git", "directory": "defects" },
